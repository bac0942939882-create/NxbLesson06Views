@model IEnumerable<NxbMember>
@{
    ViewData["Title"] = "Danh sách thành viên";
}
<h1>Index</h1>
<p><a asp-action="Create">Create New</a></p>
<div class="table-scroll">
    <table>
        <thead><tr>
            <th>Username</th><th>Full Name</th><th>Email</th><th>Phone</th><th>Status</th><th></th>
        </tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.NxbUserName</td>
                <td>@item.NxbFullName</td>
                <td>@item.NxbEmail</td>
                <td>@item.NxbPhone</td>
                <td>@item.NxbStatus</td>
                <td><a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
