@model IEnumerable<Blog>
@{ ViewData["Title"] = "Bài viết"; }
<div class="wrapper row3"><main class="hoc container clear nxb-content"><h1>Bài viết</h1><ul class="nospace group overview">
@foreach (var item in Model) { <li class="one_third"><figure><a asp-action="Details" asp-route-id="@item.Id"><img class="nxb-card-image" src="@Url.Content("~/" + (item.Image ?? "images/demo/348x261.png").TrimStart('/'))" alt="@item.Name" /></a><figcaption><h2 class="heading">@item.Name</h2><p>@item.CreatedDate.ToString("dd/MM/yyyy")</p><p>@item.Description</p><a class="btn" asp-action="Details" asp-route-id="@item.Id">Xem chi tiết</a></figcaption></figure></li> }
</ul>@if (!Model.Any()) { <p>Chưa có dữ liệu hiển thị.</p> }</main></div>
