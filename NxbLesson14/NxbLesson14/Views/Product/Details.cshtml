@model Product
@{ ViewData["Title"] = Model.Name; }
<div class="wrapper row3"><main class="hoc container clear nxb-content"><div class="nxb-detail"><img src="@Url.Content("~/" + (Model.Image ?? "images/demo/348x261.png").TrimStart('/'))" alt="@Model.Name" /><article><h1>@Model.Name</h1><p>Danh mục: @Model.Category?.Name</p><p class="nxb-price">@((Model.SalePrice > 0 ? Model.SalePrice : Model.Price).ToString("N0")) đ</p><p>@Model.Description</p><a class="btn" asp-action="Index">Quay lại</a></article></div></main></div>
