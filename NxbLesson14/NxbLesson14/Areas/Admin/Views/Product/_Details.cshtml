@model Product
<dl class="row"><dt class="col-sm-3">ID</dt><dd class="col-sm-9">@Model.Id</dd><dt class="col-sm-3">Tên</dt><dd class="col-sm-9">@Model.Name</dd><dt class="col-sm-3">Danh mục</dt><dd class="col-sm-9">@Model.Category?.Name</dd><dt class="col-sm-3">Giá</dt><dd class="col-sm-9">@Model.Price.ToString("N0")</dd><dt class="col-sm-3">Giá KM</dt><dd class="col-sm-9">@Model.SalePrice.ToString("N0")</dd><dt class="col-sm-3">Ngày tạo</dt><dd class="col-sm-9">@Model.CreatedDate.ToString("dd/MM/yyyy")</dd><dt class="col-sm-3">Trạng thái</dt><dd class="col-sm-9">@(Model.Status == 1 ? "Hiển thị" : "Ẩn")</dd><dt class="col-sm-3">Mô tả</dt><dd class="col-sm-9">@Model.Description</dd>
<dt class="col-sm-3">Ảnh</dt><dd class="col-sm-9">@if (!string.IsNullOrWhiteSpace(Model.Image)) { <img src="@Url.Content("~/" + Model.Image.TrimStart('/'))" alt="@Model.Name" class="detail-image" /> }</dd></dl>
