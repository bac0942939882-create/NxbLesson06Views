@model Category
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="form-group"><label asp-for="Name"></label>
<input asp-for="Name" type="text" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
<div class="form-group"><label asp-for="Status"></label>
<select asp-for="Status" class="form-control"><option value="1">1 - Hiển thị</option><option value="0">0 - Ẩn</option></select><span asp-validation-for="Status" class="text-danger"></span></div>
<div class="form-group"><label asp-for="CreatedDate"></label>
<input asp-for="CreatedDate" type="date" class="form-control" /><span asp-validation-for="CreatedDate" class="text-danger"></span></div>
<div class="form-group"><label asp-for="Image"></label>
<input asp-for="Image" type="text" class="form-control" /><span asp-validation-for="Image" class="text-danger"></span><small class="form-text text-muted">Ví dụ: /images/demo/348x261.png. Có thể để trống.</small></div>
<div class="form-group"><label asp-for="Description"></label>
<textarea asp-for="Description" class="form-control" rows="4" maxlength="350"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
