@model DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; }
<div class="row">
<div class="col-lg-3 col-6"><div class="small-box bg-info"><div class="inner"><h3>@Model.CategoryCount</h3><p>Danh mục</p></div><div class="icon"><i class="fas fa-list"></i></div><a asp-area="Admin" asp-controller="Category" asp-action="Index" class="small-box-footer">Xem danh sách <i class="fas fa-arrow-circle-right"></i></a></div></div>
<div class="col-lg-3 col-6"><div class="small-box bg-success"><div class="inner"><h3>@Model.ProductCount</h3><p>Sản phẩm</p></div><div class="icon"><i class="fas fa-boxes"></i></div><a asp-area="Admin" asp-controller="Product" asp-action="Index" class="small-box-footer">Xem danh sách <i class="fas fa-arrow-circle-right"></i></a></div></div>
<div class="col-lg-3 col-6"><div class="small-box bg-warning"><div class="inner"><h3>@Model.BlogCount</h3><p>Bài viết</p></div><div class="icon"><i class="fas fa-file-alt"></i></div><a asp-area="Admin" asp-controller="Blog" asp-action="Index" class="small-box-footer">Xem danh sách <i class="fas fa-arrow-circle-right"></i></a></div></div>
<div class="col-lg-3 col-6"><div class="small-box bg-danger"><div class="inner"><h3>@Model.BannerCount</h3><p>Banner</p></div><div class="icon"><i class="fas fa-image"></i></div><a asp-area="Admin" asp-controller="Banner" asp-action="Index" class="small-box-footer">Xem danh sách <i class="fas fa-arrow-circle-right"></i></a></div></div>
</div>
<div class="card"><div class="card-body"><h2 class="h5">Dashboard</h2><p>Đây là nội dung trang chủ Admin.</p></div></div>
