@{
    ViewData["Title"] = "Thông tin member";
}

<h1>GetMember</h1>

<div class="alert alert-info">
    <h3>@ViewData["Title"]</h3>
    <p><strong>Member ID:</strong> @ViewBag.Member.NxbMemberId</p>
