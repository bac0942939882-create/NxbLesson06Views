@{
    ViewData["Title"] = "Danh sách thành viên";
}

<div class="card">
    <h1>@ViewData["Title"]</h1>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Member Id</th>
                <th>User Name</th>
                <th>Full Name</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var member in (List<NxbMember>)ViewBag.Members)
        {
            <tr>
                <td>@member.NxbMemberId</td>
                <td>@member.NxbUserName</td>
                <td>@member.NxbFullName</td>
                <td>@member.NxbEmail</td>
            </tr>
        }
        </tbody>
    </table>
</div>
