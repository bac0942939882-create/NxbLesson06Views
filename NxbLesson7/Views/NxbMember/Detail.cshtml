@model NxbMember
@{
    ViewData["Title"] = "Thông tin thành viên";
}

<div class="card">
    <h1>@ViewData["Title"]</h1>
    <p><strong>Member ID:</strong> @Model.NxbMemberId</p>
    <p><strong>UserName:</strong> @Model.NxbUserName</p>
    <p><strong>Full Name:</strong> @Model.NxbFullName</p>
    <p><strong>Email:</strong> @Model.NxbEmail</p>
    <a asp-action="Index">Quay lại danh sách</a>
</div>
