<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NxbLesson7</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="navbar">
        <div class="container nav-inner">
            <a class="brand" asp-controller="Home" asp-action="Index">NxbLesson7</a>
            <nav>
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-controller="NxbMember" asp-action="GetMember">Member</a>
                <a asp-controller="NxbMember" asp-action="Members">Members</a>
                <a asp-controller="NxbMember" asp-action="Index">List Member</a>
            </nav>
        </div>
    </header>

    <main class="container main-content">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container">© 2026 - NxbLesson7 - Nguyễn Xuân Bắc</div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
