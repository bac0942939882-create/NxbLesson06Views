@model NxbStudent
<div asp-validation-summary="ModelOnly" class="text-danger validation-summary" role="alert"></div>
<div class="row g-4">
    <div class="col-12"><label asp-for="NxbName" class="form-label"></label><span class="required-mark" aria-hidden="true"> *</span><input asp-for="NxbName" class="form-control" placeholder="Nhập họ và tên đầy đủ" autocomplete="name" /><span asp-validation-for="NxbName" class="text-danger field-error"></span></div>
    <div class="col-md-6"><label asp-for="NxbGender" class="form-label"></label><span class="required-mark" aria-hidden="true"> *</span><select asp-for="NxbGender" class="form-select"><option value="Nam">Nam</option><option value="Nữ">Nữ</option><option value="Khác">Khác</option></select><span asp-validation-for="NxbGender" class="text-danger field-error"></span></div>
    <div class="col-md-6"><label asp-for="NxbBirthDay" class="form-label"></label><span class="required-mark" aria-hidden="true"> *</span><input asp-for="NxbBirthDay" asp-format="{0:yyyy-MM-dd}" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" /><span asp-validation-for="NxbBirthDay" class="text-danger field-error"></span></div>
    <div class="col-md-6"><label asp-for="NxbEmail" class="form-label"></label><span class="required-mark" aria-hidden="true"> *</span><input asp-for="NxbEmail" type="email" class="form-control" placeholder="sinhvien@example.com" autocomplete="email" /><span asp-validation-for="NxbEmail" class="text-danger field-error"></span></div>
    <div class="col-md-6"><label asp-for="NxbPhone" class="form-label"></label><span class="required-mark" aria-hidden="true"> *</span><input asp-for="NxbPhone" type="tel" class="form-control" placeholder="0900000000" autocomplete="tel" aria-describedby="phone-help" /><div id="phone-help" class="form-text">10 chữ số, bắt đầu bằng 0.</div><span asp-validation-for="NxbPhone" class="text-danger field-error"></span></div>
    <div class="col-12"><div class="active-option"><div><label asp-for="NxbActive" class="form-label mb-1"></label><p class="mb-0 text-muted small">Bật để đánh dấu hồ sơ đang hoạt động.</p></div><div class="form-check form-switch"><input asp-for="NxbActive" class="form-check-input" role="switch" /></div></div></div>
</div>
