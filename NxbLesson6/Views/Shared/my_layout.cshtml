<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NxbLesson6 - @ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@3.4.1/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<nav class="navbar navbar-inverse navbar-main">
    <div class="container">
        <div class="navbar-header">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">DEMO LAB</a>
        </div>
        <ul class="nav navbar-nav">
            <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li><a asp-controller="Home" asp-action="About">Giới thiệu</a></li>
            <li><a asp-controller="Home" asp-action="Contact">Liên hệ</a></li>
            <li><a asp-controller="Book" asp-action="Index">Sách</a></li>
        </ul>
    </div>
</nav>
<div class="container main-container">
    @RenderBody()
</div>
<footer class="footer-dark">
    <div class="container">
        <div class="row">
            <div class="col-md-6"><h4>GIỚI THIỆU</h4><p>Demo Lesson 6 - ASP.NET Core MVC, Razor, PartialView, AJAX và ViewComponent.</p></div>
            <div class="col-md-6"><h4>LIÊN HỆ</h4><p>NxbLesson6 - Bài thực hành ASP.NET Core MVC.</p></div>
        </div>
    </div>
</footer>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@3.4.1/dist/js/bootstrap.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
