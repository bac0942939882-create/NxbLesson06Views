@model Product
@{ ViewData["Title"] = "Chi tiết sản phẩm"; }
<h1>Chi tiết sản phẩm</h1><div class="card p-4 col-lg-8"><img class="detail-image rounded mb-3" src="@Model.Image" alt="Ảnh @Model.Name" /><h2>@Model.Name</h2>
<p>Danh mục: @ViewBag.Category</p><p>Giá chuẩn: @Model.Price.ToString("N0") đ</p><p>Giá khuyến mại: @Model.SalePrice.ToString("N0") đ</p><p>Mô tả: @Model.Description</p>
<div><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Sửa</a> <a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a></div></div>
