@model Product
@{ ViewData["Title"] = "Xóa sản phẩm"; }
<h1>Xóa sản phẩm</h1><div class="alert alert-warning">Bạn có chắc muốn xóa sản phẩm <strong>@Model.Name</strong>?</div>
<form asp-action="Delete" asp-route-id="@Model.Id" method="post"><button type="submit" class="btn btn-danger">Xác nhận xóa</button> <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a></form>
