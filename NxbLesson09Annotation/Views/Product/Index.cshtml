@model IEnumerable<Product>
@{ ViewData["Title"] = "Quản lý sản phẩm"; var categories = (IReadOnlyList<Category>)ViewBag.Categories; }
<h1>Quản lý sản phẩm</h1><p><a class="btn btn-primary" asp-action="Create">Thêm sản phẩm</a></p>
@if (!Model.Any()) { <p>Chưa có sản phẩm. Hãy thêm sản phẩm đầu tiên.</p> }
else { <div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>Ảnh</th><th>Tên sản phẩm</th><th>Danh mục</th><th>Giá chuẩn</th><th>Giá khuyến mại</th><th>Thao tác</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td><img class="product-image rounded" src="@item.Image" alt="Ảnh @item.Name" /></td><td>@item.Name</td><td>@categories.FirstOrDefault(c => c.Id == item.CategoryId)?.Name</td><td>@item.Price.ToString("N0") đ</td><td>@item.SalePrice.ToString("N0") đ</td><td><a asp-action="Details" asp-route-id="@item.Id">Xem</a> · <a asp-action="Edit" asp-route-id="@item.Id">Sửa</a> · <a class="text-danger" asp-action="Delete" asp-route-id="@item.Id">Xóa</a></td></tr> }
</tbody></table></div> }
