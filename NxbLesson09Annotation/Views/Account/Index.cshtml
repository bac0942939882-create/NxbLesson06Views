@model IEnumerable<Account>
@{ ViewData["Title"] = "Danh sách Account"; }
<h1>Danh sách Account</h1><p><a class="btn btn-primary" asp-action="Create">Thêm Account</a></p>
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Id</th><th>Họ và tên</th><th>Email</th><th>Số điện thoại</th><th>Địa chỉ</th><th>Ảnh</th><th>Ngày sinh</th><th>Giới tính</th><th>Facebook</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.Id</td><td>@item.FullName</td><td>@item.Email</td><td>@item.Phone</td><td>@item.Address</td><td>@item.Avatar</td><td>@item.Birthday.ToString("dd/MM/yyyy")</td><td>@item.Gender</td><td>@item.Facebook</td></tr> }
</tbody></table></div>
