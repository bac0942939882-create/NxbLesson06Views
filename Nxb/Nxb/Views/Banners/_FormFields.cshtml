@model BannerForm
<div class="mb-3"><label asp-for="Name" class="form-label"></label>
<input asp-for="Name" type="text" class="form-control" />
<span asp-validation-for="Name" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="ImageFile" class="form-label"></label>
<input asp-for="ImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.gif,.webp" />
<div class="form-text">JPG, PNG, GIF, WebP; tối đa 5 MB. Khi sửa, để trống để giữ ảnh hiện tại.</div>
@if (!string.IsNullOrWhiteSpace(Model.CurrentImage)) { <img src="/Banner/@Model.CurrentImage" alt="Ảnh hiện tại" class="preview-image mt-2" /> }
<span asp-validation-for="ImageFile" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Description" class="form-label"></label>
<textarea asp-for="Description" class="form-control" rows="4"></textarea>
<span asp-validation-for="Description" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Status" class="form-label"></label>
<select asp-for="Status" class="form-select"><option value="1">Hiển thị</option><option value="0">Tạm ẩn</option></select>
<span asp-validation-for="Status" class="text-danger"></span></div>