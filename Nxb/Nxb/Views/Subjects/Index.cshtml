@model IEnumerable<Subjects>
@{ ViewData["Title"] = "Danh sách môn học"; }
<div class="page-heading"><h1>Danh sách môn học</h1><a asp-action="Create" class="btn btn-success">Thêm mới</a></div>
<div class="table-responsive panel"><table class="table table-hover align-middle mb-0">
<thead><tr><th>Tên môn học</th><th>Thao tác</th></tr></thead><tbody>
@foreach (var item in Model)
{
    <tr><td>@item.SubjectName</td><td class="actions">
        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Sửa</a>
        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-success btn-sm">Chi tiết</a>
        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Xóa</a>
    </td></tr>
}
@if (!Model.Any()) { <tr><td colspan="2" class="text-center py-4 text-muted">Chưa có dữ liệu.</td></tr> }
</tbody></table></div>
