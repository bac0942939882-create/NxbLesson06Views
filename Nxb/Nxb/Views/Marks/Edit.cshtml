@model MarksForm
@{ ViewData["Title"] = "Chỉnh sửa điểm"; ViewData["ReadOnlyKeys"] = true; }
<h1>Chỉnh sửa điểm</h1>
<form asp-action="Edit" asp-route-originalSubjectId="@Model.SubjectId" asp-route-originalStudentId="@Model.StudentId" method="post" enctype="multipart/form-data" class="panel p-4 form-panel">
<div asp-validation-summary="All" class="text-danger"></div>

<partial name="_FormFields" model="Model" />
<button type="submit" class="btn btn-success">Lưu lại</button> <a asp-action="Index" class="btn btn-outline-secondary">Về danh sách</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
