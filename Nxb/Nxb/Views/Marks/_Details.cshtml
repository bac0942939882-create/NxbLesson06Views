@model Marks
<dl class="row mb-0">
<dt class="col-sm-3">Mã sinh viên</dt><dd class="col-sm-9">@Model.StudentId</dd><dt class="col-sm-3">Mã môn học</dt><dd class="col-sm-9">@Model.SubjectId</dd>
<dt class="col-sm-3">Sinh viên</dt><dd class="col-sm-9">@Model.Student.StudentName</dd>
<dt class="col-sm-3">Môn học</dt><dd class="col-sm-9">@Model.Subject.SubjectName</dd>
<dt class="col-sm-3">Điểm</dt><dd class="col-sm-9">@Model.Score</dd>
</dl>