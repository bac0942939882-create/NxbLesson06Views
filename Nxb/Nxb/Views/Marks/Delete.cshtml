@model Marks
@{ ViewData["Title"] = "Xóa điểm"; }
<h1>Xóa điểm</h1>
<p class="text-danger">Bạn có chắc chắn muốn xóa bản ghi này?</p>
<div asp-validation-summary="All" class="text-danger mb-3"></div>
<div class="panel p-4"><partial name="_Details" model="Model" /></div>
<form asp-action="Delete" asp-route-subjectId="@Model.SubjectId" asp-route-studentId="@Model.StudentId" method="post" class="mt-3">
<input type="hidden" asp-for="SubjectId" /><input type="hidden" asp-for="StudentId" /><button class="btn btn-danger" type="submit">Xác nhận xóa</button> <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
</form>
