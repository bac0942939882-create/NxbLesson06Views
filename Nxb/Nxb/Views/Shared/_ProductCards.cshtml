@model IEnumerable<Product>
<div class="row g-4">
@foreach (var item in Model)
{
    <div class="col-12 col-sm-6 col-lg-3"><div class="card h-100 product-card">
        <img src="/Product/@item.Image" class="card-img-top" alt="@item.Name" />
        <div class="card-body text-center"><h3 class="h6">@item.Name</h3>
            @if (item.SalePrice > 0 && item.SalePrice < item.Price)
            { <p class="mb-1 text-muted"><del>@item.Price.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) đ</del></p> }
            <p class="fw-semibold mb-2">@((item.SalePrice > 0 ? item.SalePrice : item.Price).ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))) đ</p>
            <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Xem chi tiết</a>
        </div></div></div>
}
@if (!Model.Any()) { <p class="text-muted">Chưa có sản phẩm được hiển thị.</p> }
</div>
