@model IEnumerable<Student>
@{ ViewData["Title"] = "Danh sách sinh viên"; }
<div class="page-heading"><h1>Danh sách sinh viên</h1><a asp-action="Create" class="btn btn-success">Thêm mới</a></div>
<div class="table-responsive panel"><table class="table table-hover align-middle mb-0">
<thead><tr><th>Họ tên</th><th>Ảnh đại diện</th><th>Email</th><th>SĐT</th><th>Địa chỉ</th><th>Ngày sinh</th><th>Lớp</th><th>Thao tác</th></tr></thead><tbody>
@foreach (var item in Model)
{
    <tr><td>@item.StudentName</td>
<td><img class="table-image" src="/Avatar/@item.StudentAvatar" alt="Ảnh" /></td>
<td>@item.StudentEmail</td>
<td>@item.StudentPhone</td>
<td>@item.StudentAddress</td>
<td>@item.StudentBirthday.ToString("dd/MM/yyyy")</td>
<td>@item.Class.ClassName</td><td class="actions">
        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Sửa</a>
        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-success btn-sm">Chi tiết</a>
        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Xóa</a>
    </td></tr>
}
@if (!Model.Any()) { <tr><td colspan="8" class="text-center py-4 text-muted">Chưa có dữ liệu.</td></tr> }
</tbody></table></div>
