@model IEnumerable<NxbLesson06Views.Models.Category>

<div class="bg-danger p-2 rounded">
    <ul class="list-group">
        <li class="list-group-item active" aria-current="true">DANH MỤC</li>

        @foreach (var item in Model)
        {
            <li class="list-group-item">
                <a href="#" class="text-decoration-none">@item.CategoryName</a>
            </li>
        }
    </ul>
</div>
